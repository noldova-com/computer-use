{
  "name": "noldova-computer-use",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "26.13.1",
    "npm": "11.20.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "peers:newest": "node scripts/move-peers.ts",
    "test": "node scripts/test.ts",
    "test:e2e": "tsc -p e2e/tsconfig.json && playwright test --config e2e/playwright.config.ts",
    "test:e2e:desktop": "tsc -p e2e/tsconfig.json && playwright test --config e2e/playwright.desktop.config.ts",
    "test:e2e:grant-hosted-macos": "node e2e/grant-hosted-macos.ts",
    "test:e2e:lock": "node e2e/prepare-app.ts lock",
    "test:e2e:prepare": "node e2e/prepare-app.ts",
    "test:timing": "node scripts/test-timing.ts"
  },
  "devDependencies": {
    "@angular/cdk": "22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@noldova/context.core": "0.0.13",
    "@noldova/context.exceptions": "0.0.13",
    "@noldova/context.json": "0.0.13",
    "@noldova/context.text": "0.0.13",
    "@noldova/desktop.protocol": "0.0.17",
    "@noldova/desktop.runtime": "0.0.17",
    "@noldova/desktop.window": "0.0.17",
    "@noldova/ui.components.angular": "0.0.33",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
