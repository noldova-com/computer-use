{
  "name": "computer-use-test-app",
  "version": "0.0.1",
  "desktop": {
    "protocolVersion": 1,
    "modulePackagePrefix": "@computer-use-test/app.",
    "modules": [
      "agent-double",
      {
        "id": "computer-use",
        "package": "@noldova/computer-use"
      }
    ],
    "product": {
      "name": "Computer Use Test",
      "publisher": "Noldova",
      "slug": "computer-use-test",
      "applicationId": "com.noldova.computerusetest",
      "developmentApplicationId": "com.noldova.computerusetest.development",
      "dataFolder": ".noldova/computer-use-test",
      "deviceFolders": {
        "windows": "Noldova/ComputerUseTest",
        "macos": "Noldova/ComputerUseTest",
        "linux": "noldova/computer-use-test"
      },
      "dataDirectoryVariable": "COMPUTER_USE_TEST_DATA_DIR",
      "icons": "assets/icons",
      "releaseRepository": "noldova-com/computer-use",
      "permissionsModule": "agent-double"
    },
    "supportedTargets": [],
    "signedPlatforms": [
      "windows",
      "macos"
    ]
  },
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "26.13.1",
    "npm": "11.20.0"
  },
  "workspaces": [
    "src/computer-use-test.window.app"
  ],
  "scripts": {
    "install:app": "noldova-desktop-build install",
    "build:app": "noldova-desktop-build build",
    "desktop-tools": "noldova-desktop-build desktop-tools"
  },
  "dependencies": {
    "@noldova/context.core": "0.0.9",
    "@noldova/context.exceptions": "0.0.9",
    "@noldova/context.json": "0.0.9",
    "@noldova/context.text": "0.0.9",
    "@noldova/desktop.cli": "0.0.9",
    "@noldova/desktop.electron": "0.0.9",
    "@noldova/desktop.protocol": "0.0.9",
    "@noldova/desktop.runtime": "0.0.9"
  },
  "devDependencies": {
    "@noldova/desktop.build": "0.0.9",
    "@types/node": "26.6.6",
    "electron": "44.9.1",
    "electron-builder": "26.16.1",
    "typescript": "6.0.3"
  }
}
