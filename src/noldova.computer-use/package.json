{
  "name": "@noldova/computer-use",
  "version": "0.0.2",
  "description": "The computer use module for apps on Noldova Desktop: agent tools that see the screen and use the pointer and keyboard, with the person's permission, and the window's status and stop control.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noldova-com/computer-use.git",
    "directory": "src/noldova.computer-use"
  },
  "homepage": "https://github.com/noldova-com/computer-use#readme",
  "bugs": {
    "url": "https://github.com/noldova-com/computer-use/issues"
  },
  "exports": {
    "./runtime": "./api/runtime.ts",
    "./window": "./api/window.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "module.json",
    "settings.json",
    "api/*.js",
    "api/*.js.map",
    "api/*.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@noldova/computer-use.runtime": "0.0.2",
    "@noldova/computer-use.window": "0.0.2"
  },
  "peerDependencies": {
    "@noldova/desktop.protocol": ">=0.0.10 <0.1.0",
    "@noldova/desktop.runtime": ">=0.0.10 <0.1.0"
  }
}
